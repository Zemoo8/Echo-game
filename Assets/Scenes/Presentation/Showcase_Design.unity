--- !u!114 &1987072481
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1987072480}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 92d663eece5385d4887313326977f042, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Echo::Echo.Presentation.DesignShowcase
  slides:
  - title: VISUAL DESIGN
    subtitle: "PHASE 3 \xB7 DESIGN"
    caption: "A dark sci-fi facility told in one neon language. Pixel art at 32 px
      per unit, rendered at 640\xD7360 and scaled up sharp to any screen."
    cameraX: 60
    voidColor: {r: 0, g: 0.015686275, b: 0.0627451, a: 1}
    ambientColor: {r: 0.85, g: 0.93, b: 1, a: 1}
    ambientIntensity: 0.85
    music: 1
    overlay: {fileID: 996656356}
    dim: 0.72
  - title: COLOR LANGUAGE
    subtitle: ART DIRECTION
    caption: Every color has one job, so any screen reads at a glance. Cyan is energy,
      warm red is danger, green is the way out. Nothing friendly is ever warm.
    cameraX: 60
    voidColor: {r: 0, g: 0.015686275, b: 0.0627451, a: 1}
    ambientColor: {r: 0.85, g: 0.93, b: 1, a: 1}
    ambientIntensity: 0.85
    music: 1
    overlay: {fileID: 787973650}
    dim: 0.88
  - title: THE HERO
    subtitle: CHARACTER
    caption: 'Recolored from Ansimuz''s Warped City hero: a white jacket with cool
      shading (yellow would read as danger), magenta hair and a cyan accent. Squash
      and stretch on every jump and landing.'
    cameraX: 0
    voidColor: {r: 0, g: 0.015686275, b: 0.0627451, a: 1}
    ambientColor: {r: 0.85, g: 0.93, b: 1, a: 1}
    ambientIntensity: 0.85
    music: 2
    overlay: {fileID: 1005657335}
    dim: 0
  - title: THREATS AND TOOLS
    subtitle: GAMEPLAY OBJECTS
    caption: 'Danger is always warm: pits glow red and enemy eyes burn red. Energy
      cells and the barriers a dash breaks are cyan; the exit door is green. Drones
      and turrets guard the security wing, and a dash destroys them.'
    cameraX: 30
    voidColor: {r: 0, g: 0.015686275, b: 0.0627451, a: 1}
    ambientColor: {r: 0.85, g: 0.93, b: 1, a: 1}
    ambientIntensity: 0.85
    music: 2
    overlay: {fileID: 1105612420}
    dim: 0
  - title: ABANDONED LAB
    subtitle: SECTOR 1
    caption: Dark teal corridors, cryo pods and dead monitors under dim cyan ceiling
      lights. The city glows through the windows.
    cameraX: 60
    voidColor: {r: 0, g: 0.015686275, b: 0.0627451, a: 1}
    ambientColor: {r: 0.85, g: 0.93, b: 1, a: 1}
    ambientIntensity: 0.85
    music: 2
    overlay: {fileID: 0}
    dim: 0
  - title: SECURITY WING
    subtitle: SECTOR 2
    caption: Cold steel bulkheads and hard white light. Red scanners sweep the halls
      and turrets guard the doors.
    cameraX: 90
    voidColor: {r: 0.02745098, g: 0.03529412, b: 0.039215688, a: 1}
    ambientColor: {r: 0.8, g: 0.88, b: 1, a: 1}
    ambientIntensity: 0.8
    music: 3
    overlay: {fileID: 0}
    dim: 0
  - title: ENERGY CORE
    subtitle: SECTOR 3
    caption: Deep navy machinery wrapped in cyan conduits. Everything here hums with
      the energy ECHO runs on.
    cameraX: 120
    voidColor: {r: 0.015686275, g: 0.023529412, b: 0.05882353, a: 1}
    ambientColor: {r: 0.75, g: 0.85, b: 1, a: 1}
    ambientIntensity: 0.75
    music: 4
    overlay: {fileID: 0}
    dim: 0
  - title: THE GUARDIAN'S REACTOR
    subtitle: FINAL ARENA
    caption: The central reactor. Calm, it glows energy cyan; when the Guardian attacks
      it overloads to danger red.
    cameraX: 150
    voidColor: {r: 0.011764706, g: 0.015686275, b: 0.043137256, a: 1}
    ambientColor: {r: 0.7, g: 0.78, b: 1, a: 1}
    ambientIntensity: 0.6
    music: 5
    overlay: {fileID: 332147955}
    dim: 0
  - title: INTERFACE
    subtitle: UI
    caption: 'Drawn in the same palette: dark translucent panels, white Kenney Future
      text, cyan for anything energy. The meter shows exactly how many dashes are
      left.'
    cameraX: 60
    voidColor: {r: 0, g: 0.015686275, b: 0.0627451, a: 1}
    ambientColor: {r: 0.85, g: 0.93, b: 1, a: 1}
    ambientIntensity: 0.85
    music: 1
    overlay: {fileID: 1774989641}
    dim: 0.88
  worldCamera: {fileID: 1898201319}
  globalLight: {fileID: 368068198}
  cameraY: 2.6
  titleText: {fileID: 1758093330}
  subtitleText: {fileID: 4583085}
  captionText: {fileID: 1566284683}
  pageText: {fileID: 2951517}
  dimmer: {fileID: 1231816285}
  previousButton: {fileID: 2053437947}
  nextButton: {fileID: 1362502197}
  menuButton: {fileID: 741242132}
